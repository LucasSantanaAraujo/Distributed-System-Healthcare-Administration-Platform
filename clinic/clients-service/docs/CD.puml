@startuml UML Class Diagram - Clients-Service
class User {
    - Long id
    - String name
    - String email
    - String password
    - Role role
    - Patient patient
    + User()
    + User(String name, String email, String password, Role role)
}

class Patient {
    - Long id
    - String name
    - LocalDate birthDate
    - String contact
    - String insuranceInfo
    - boolean consent
    - User user
    + Patient()
    + Patient(String name, LocalDate birthDate, String contact, String insuranceInfo, boolean consent)
}

class AuthController {
    - UserRepository userRepository
    + ResponseEntity<?> register(AuthRequest request, String authHeader)
    + ResponseEntity<?> login(AuthRequest request)
    + ResponseEntity<?> registerPatient(PatientRegisterRequest request)
}

class PatientController {
    - UserRepository userRepository
    - PatientRepository patientRepository
    + ResponseEntity<List<PatientResponse>> getAllPatients()
    + ResponseEntity<?> getPatientById(Long id)
    + ResponseEntity<?> searchPatientsByName(String name)
    + ResponseEntity<?> updateMyData(Long id, PatientUpdateRequest request)
}

User "1" -- "0..1" Patient : composição
AuthController ..> UserRepository : utiliza
PatientController ..> UserRepository : utiliza
PatientController ..> PatientRepository : utiliza
@enduml
