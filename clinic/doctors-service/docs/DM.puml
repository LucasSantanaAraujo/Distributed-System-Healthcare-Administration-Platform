@startuml Domain Model - Doctors-Service
class Physician {
    - id: Long
    - name: String
    - specialty: String
    - contact: String
    - schedule: String
    - photoPath: String
}

class Appointment {
    - id: Long
    - dateTime: LocalDateTime
    - reason: String
    - status: AppointmentStatus
    - patientId: Long (remote reference)
    - physician: Physician
    - recordId: Long (remote reference)
}

enum AppointmentStatus {
    CONFIRMED
    CANCELLED
    RESCHEDULED
    PENDING
}

Physician ||--o{ Appointment : "1..* (physician.appointments)"
@enduml
