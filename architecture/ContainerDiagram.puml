@startuml C4 Container Diagram - Big Picture (Clinica Medica Microservices)
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(patient, "Paciente", "User que agenda consultas e vê registos médicos")
Person(physician, "Médico", "Profissional que gere consultas e cria registos médicos")
Person(admin, "Administrador", "User que gere médicos, pacientes e consultas")

System_Boundary(clinic_system, "Sistema de Clínica Médica") {
    Container(clients_service, "Clients-Service", "Spring Boot (Java + Maven)", "Microserviço para gestão de pacientes e autenticação (entidades: User, Patient; controladores: AuthController, PatientController)")
    ContainerDb(clients_db, "Banco de Dados Clients", "H2", "Armazena dados de utilizadores e pacientes (JPA/Hibernate)")

    Container(doctors_service, "Doctors-Service", "Spring Boot (Java + Maven)", "Microserviço para gestão de médicos (entidade: Physician; controlador: PhysicianController)")
    ContainerDb(doctors_db, "Banco de Dados Doctors", "H2", "Armazena dados de médicos (JPA/Hibernate)")

    Container(appointments_service, "Appointments-Service", "Spring Boot (Java + Maven)", "Microserviço para gestão de consultas (entidade: Appointment; controlador: AppointmentController)")
    ContainerDb(appointments_db, "Banco de Dados Appointments", "H2", "Armazena dados de consultas (JPA/Hibernate)")

    Container(notes_service, "Notes-Service", "Spring Boot (Java + Maven)", "Microserviço para gestão de registos médicos (entidade: AppointmentRecord; controlador: RecordController)")
    ContainerDb(notes_db, "Banco de Dados Notes", "H2", "Armazena registos de consultas (JPA/Hibernate)")

    Container(security_service, "Security-Service", "Spring Boot (Java + Maven)", "Microserviço para gestão de autenticação JWT e segurança")
    ContainerDb(security_db, "Banco de Dados Security", "H2", "Armazena dados de segurança (JPA/Hibernate)")
}

Rel(patient, clients_service, "Utiliza para autenticação e ver dados pessoais", "REST/HTTPS")
Rel(patient, appointments_service, "Utiliza para agendar consultas", "REST/HTTPS")
Rel(physician, doctors_service, "Utiliza para gerir dados pessoais", "REST/HTTPS")
Rel(physician, appointments_service, "Utiliza para gerir consultas", "REST/HTTPS")
Rel(physician, notes_service, "Utiliza para criar/ver registos médicos", "REST/HTTPS")
Rel(admin, clients_service, "Utiliza para gestão de pacientes", "REST/HTTPS")
Rel(admin, doctors_service, "Utiliza para gestão de médicos", "REST/HTTPS")
Rel(admin, appointments_service, "Utiliza para gestão de consultas", "REST/HTTPS")

Rel(appointments_service, clients_service, "Consulta dados de pacientes diretamente", "REST/HTTPS (WebClient)")
Rel(notes_service, appointments_service, "Referência remota a consultas diretamente", "REST/HTTPS (potencial)")

Rel(clients_service, clients_db, "Lê/escreve", "JDBC")
Rel(doctors_service, doctors_db, "Lê/escreve", "JDBC")
Rel(appointments_service, appointments_db, "Lê/escreve", "JDBC")
Rel(notes_service, notes_db, "Lê/escreve", "JDBC")

Rel(clients_service, security_service, "Valida tokens JWT para autenticação", "REST/HTTPS (WebClient)")
Rel(doctors_service, security_service, "Valida tokens JWT para acesso seguro", "REST/HTTPS (WebClient)")
Rel(appointments_service, security_service, "Valida tokens JWT antes de agendar", "REST/HTTPS (WebClient)")
Rel(notes_service, security_service, "Valida tokens JWT para registros médicos", "REST/HTTPS (WebClient)")
Rel(security_service, security_db, "Lê/escreve dados de segurança", "JDBC")
@enduml
