@startuml UML Class Diagram - Doctors-Service
class Physician {
    - Long id
    - String name
    - Specialty specialty
    + Physician()
    + Physician(String name, Specialty specialty)
}

class Specialty {
    - Long id
    - String name
    + Specialty()
    + Specialty(String name)
}

class PhysicianController {
    - PhysicianRepository physicianRepository
    + ResponseEntity<List<PhysicianResponse>> getAllPhysicians()
    + ResponseEntity<?> getPhysicianById(Long id)
    + ResponseEntity<?> createPhysician(PhysicianRequest request)
}

Physician "1" -- "1" Specialty : associação
PhysicianController ..> PhysicianRepository : utiliza
@enduml
